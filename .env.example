# LineCare settings. Copy to .env (git-ignored) or set as environment variables.

# Any OpenAI-compatible server. LM Studio's default port is 1234; this project uses 1235.
LLM_BASE_URL=http://localhost:1235/v1
LLM_MODEL=gemma-4-26b-a4b-it
LLM_TIMEOUT_SECONDS=120
# "none" skips the model's hidden reasoning; leave empty for the model's default.
LLM_REASONING_EFFORT=none
LLM_CONTEXT_LENGTH=16384
MAX_TOOL_ROUNDS=8

# SQLite file for the mock systems (reseeded at every start) and the conversation log.
DB_PATH=data/linecare.db

# Freeze "now" for a repeatable demo, e.g. 2026-11-20T10:00:00. Empty = the real clock.
FROZEN_NOW=
