# LineCare settings. Copy to .env (git-ignored) or set as environment variables.

# Any OpenAI-compatible server. LM Studio's default port is 1234; this project uses 1235.
LLM_BASE_URL=http://localhost:1235/v1
LLM_MODEL=gemma-4-26b-a4b-it
LLM_TIMEOUT_SECONDS=120
# "none" skips the model's hidden reasoning; leave empty for the model's default.
LLM_REASONING_EFFORT=none
LLM_CONTEXT_LENGTH=16384
MAX_TOOL_ROUNDS=8

# SQLite file for the mock systems (reseeded at every start) and the conversation log.
DB_PATH=data/linecare.db

# Knowledge base. Embeddings run on the CPU (ONNX via fastembed, no torch); the model is downloaded on first use
# (about 0.2 GB) into EMBED_CACHE_DIR. EMBEDDER=fake is for tests only.
CHROMA_PATH=data/chroma
EMBEDDER=onnx
EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBED_CACHE_DIR=data/fastembed
# Empty = the threshold calibrated for EMBED_MODEL (see evals/results/retrieval.md).
KB_MIN_SCORE=
# 1 = also index kb/test (a poisoned document for injection evals). Never in the demo.
KB_INCLUDE_TEST_DOCS=0

# Freeze "now" for a repeatable demo, e.g. 2026-11-20T10:00:00. Empty = the real clock.
FROZEN_NOW=
